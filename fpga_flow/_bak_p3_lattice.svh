// memory map (HOME-cell addressed; see the header comment)
localparam integer SNOW_LAT_NEB    = 180;
localparam integer SNOW_LAT_MIR    = 450;
localparam integer SNOW_LAT_EMIR   = 630;
localparam integer SNOW_LAT_MEM    = 900;
localparam integer SNOW_LAT_NBM    = 450;
localparam integer SNOW_LAT_EBM    = 450;
localparam integer SNOW_LAT_AW     = 10;
