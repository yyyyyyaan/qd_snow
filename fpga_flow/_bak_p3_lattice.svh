// stride widths of the per-cell tables (the RTL indexes them with these)
localparam integer SNOW_LAT_ABW    = 10;
localparam integer SNOW_LAT_SIDW2  = 3;
localparam integer SNOW_LAT_NCW    = 6;
localparam integer SNOW_LAT_EAW    = 5;

// ---- per-(slot, slice) direction tables, index = (slot*NCTX + c)*NDIR + d
