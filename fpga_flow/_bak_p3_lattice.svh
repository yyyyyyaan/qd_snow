`ifndef SNOWFLAKE_LATTICE_SVH
`define SNOWFLAKE_LATTICE_SVH
// the lattice tables extend the graph tables, so pull those in first:
// snowflake_pe.sv needs SNOW_PE_STW, which is defined below.
`include "snowflake_graph.svh"

// ---- packed state word widths (needed by snowflake_pe.sv at parse time)
localparam integer SNOW_PE_STW    = 16;
