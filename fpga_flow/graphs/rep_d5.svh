localparam integer SNOW_NCROSS_EDGES = 16;
  // 跨 leaf 的边（索引表），供 hub 转发连接
  function automatic [SNOW_EW-1:0] SNOW_CROSS_EDGE(input integer a0);
    begin
      SNOW_CROSS_EDGE = SNOW_NO_EDGE;
      case (a0)
        0 : SNOW_CROSS_EDGE = 9;
        1 : SNOW_CROSS_EDGE = 11;
        2 : SNOW_CROSS_EDGE = 13;
        3 : SNOW_CROSS_EDGE = 16;
        4 : SNOW_CROSS_EDGE = 17;
        5 : SNOW_CROSS_EDGE = 19;
        6 : SNOW_CROSS_EDGE = 21;
        7 : SNOW_CROSS_EDGE = 24;
        8 : SNOW_CROSS_EDGE = 25;
        9 : SNOW_CROSS_EDGE = 27;
        10 : SNOW_CROSS_EDGE = 29;
        11 : SNOW_CROSS_EDGE = 32;
        12 : SNOW_CROSS_EDGE = 33;
        13 : SNOW_CROSS_EDGE = 35;
        14 : SNOW_CROSS_EDGE = 37;
        15 : SNOW_CROSS_EDGE = 40;
      endcase
    end
  endfunction

