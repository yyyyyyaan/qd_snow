  function automatic [4:0] SNOW_CID_DELTA(input integer a0);
    begin
      SNOW_CID_DELTA = 5'd10;
      if (a0 >= 50) SNOW_CID_DELTA = 5'd20;
    end
  endfunction

  // 指针码 -> 方向名(3 字符), 供 testbench 打印
  function automatic [23:0] SNOW_PTR_STR(input integer a0);
    begin
      SNOW_PTR_STR = "C  ";
      case (a0)
        1 : SNOW_PTR_STR = "N  ";
        2 : SNOW_PTR_STR = "W  ";
        3 : SNOW_PTR_STR = "D  ";
        4 : SNOW_PTR_STR = "U  ";
        5 : SNOW_PTR_STR = "E  ";
        6 : SNOW_PTR_STR = "S  ";
      endcase
    end
  endfunction

