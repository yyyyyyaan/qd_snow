  // drop 时 cid 的映射步长: 与 localuf 的 Snowflake.id_below 公式一致
  function automatic [8:0] SNOW_CID_DELTA(input integer a0);
    begin
      SNOW_CID_DELTA = 9'd42;
      if (a0 >= 882) SNOW_CID_DELTA = 9'd420;
    end
  endfunction

  // 指针码 -> 方向名(3 字符), 供 testbench 打印
  function automatic [23:0] SNOW_PTR_STR(input integer a0);
    begin
      SNOW_PTR_STR = "C  ";
      case (a0)
        1 : SNOW_PTR_STR = "NWD";
        2 : SNOW_PTR_STR = "N  ";
        3 : SNOW_PTR_STR = "NU ";
        4 : SNOW_PTR_STR = "WD ";
        5 : SNOW_PTR_STR = "W  ";
        6 : SNOW_PTR_STR = "D  ";
