#=====================================================================
# smoke_impl.tcl -- out-of-context synth + place&route + timing for the
# flat Snowflake core.  One config per Vivado process.
#
#   env SMOKE_REPO    repo root (Helios_scalable_QEC-main/Helios_scalable_QEC-main)
#   env SMOKE_PART    e.g. xcvu29p-fsvh2892-2-e
#   env SMOKE_PERIOD  clock period in ns, e.g. 5.0
#   env SMOKE_TAG     file-name tag for this run
#   env SMOKE_OUT     output directory
#
# The graph tables live in design/generated/snowflake_graph.svh, which is
# regenerated by build_scripts/generate_snowflake.py before this runs.
#=====================================================================
set repo   $::env(SMOKE_REPO)
set part   $::env(SMOKE_PART)
set period $::env(SMOKE_PERIOD)
set tag    $::env(SMOKE_TAG)
set outdir $::env(SMOKE_OUT)

file mkdir $outdir

# ---- out-of-context constraints, generated per run so the period is a knob
set fh [open "$outdir/ooc_$tag.xdc" w]
puts $fh "create_clock -name clk -period $period \[get_ports clk\]"
puts $fh "set_input_delay  -clock clk 0.0 \[remove_from_collection \[all_inputs\] \[get_ports clk\]\]"
puts $fh "set_output_delay -clock clk 0.0 \[all_outputs\]"
close $fh
read_xdc "$outdir/ooc_$tag.xdc"

read_verilog -sv "$repo/design/snowflake/snowflake_core.sv"

synth_design -top snowflake_core -part $part -mode out_of_context -flatten_hierarchy none
report_utilization -file "$outdir/util_synth_$tag.rpt"

opt_design
place_design
phys_opt_design
route_design

report_timing_summary -delay_type max -max_paths 10 -file "$outdir/timing_$tag.rpt"
report_utilization     -file "$outdir/util_route_$tag.rpt"
report_design_analysis -logic_level_distribution -file "$outdir/logic_levels_$tag.rpt"
write_checkpoint -force "$outdir/postroute_$tag.dcp"

set wns  [get_property SLACK [get_timing_paths -delay_type max -max_paths 1]]
set luts [llength [get_cells -hier -filter {REF_NAME =~ LUT*}]]
set ffs  [llength [get_cells -hier -filter {REF_NAME =~ FD*}]]
set lvls ""
if {![catch {set tp [get_timing_paths -delay_type max -max_paths 1]}] && [llength $tp]} {
  set lvls [get_property LOGIC_LEVELS $tp]
}
puts "SMOKE_RESULT $tag part=$part period=$period wns=$wns lut_cells=$luts ff_cells=$ffs logic_levels=$lvls"
puts "SMOKE_DONE $tag"
